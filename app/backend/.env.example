# --- База -------------------------------------------------------------
# Владелец схемы: миграции, сид, запись из приложения.
DATABASE_URL=postgresql+psycopg2://wallet:wallet@localhost:5433/wallet

# Роль SQL-консоли. Только GRANT SELECT на public.wallets и public.operations.
# Логин/пароль создаёт миграция 0002 и пересоздаёт сид после DROP SCHEMA.
READONLY_DATABASE_URL=postgresql+psycopg2://qa_student:qa_student@localhost:5433/wallet
QA_STUDENT_ROLE=qa_student
QA_STUDENT_PASSWORD=qa_student

# --- Приложение -------------------------------------------------------
# Проекция OperationView: файловый снимок + память. В схему базы не входит,
# SQL-консоли не видна.
OPERATION_VIEW_PATH=./data/operation_view.jsonl

# Куда сид кладёт выданные логины и пароли. В репозиторий не коммитится.
CREDENTIALS_OUT=./data/cohort-credentials.csv

# Сколько кошельков создать: student-01 … student-NN.
COHORT_SIZE=20

# --- Лимиты (часть контракта продукта, менять только вместе с ним) ----
RATE_LIMIT_PER_MINUTE=600
SQL_STATEMENT_TIMEOUT=5s
SQL_ROW_LIMIT=300
TOKEN_TTL_DAYS=7
